<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Logo / Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♥ TikTap Auto"
            android:textSize="34sp"
            android:textColor="#fe2c55"
            android:textStyle="bold"
            android:layout_marginTop="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap Tap automático para TikTok Live"
            android:textSize="14sp"
            android:textColor="#aaaaaa"
            android:layout_marginBottom="28dp" />

        <!-- Estado de accesibilidad -->
        <TextView
            android:id="@+id/tv_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verificando accesibilidad..."
            android:textSize="14sp"
            android:padding="14dp"
            android:background="#2a2a3e"
            android:textColor="@android:color/white"
            android:layout_marginBottom="12dp" />

        <!-- Estado actual del tap -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inactivo"
            android:textSize="17sp"
            android:textStyle="bold"
            android:padding="16dp"
            android:gravity="center"
            android:background="#2a2a3e"
            android:textColor="@android:color/white"
            android:layout_marginBottom="24dp" />

        <!-- Control de velocidad -->
        <TextView
            android:id="@+id/tv_interval"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Velocidad: un tap tap cada 800ms"
            android:textSize="15sp"
            android:textColor="#dddddd"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seekbar_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="#fe2c55"
            android:thumbTint="#fe2c55"
            android:layout_marginBottom="28dp" />

        <!-- Botón principal -->
        <Button
            android:id="@+id/btn_start_stop"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="INICIAR TAP TAP"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="@android:color/holo_green_dark"
            android:layout_marginBottom="28dp" />

        <!-- Instrucciones -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cómo usar:\n\n1. Toca el texto rojo para activar el\n   Servicio de accesibilidad\n2. Otorga el permiso de superposición\n   cuando se solicite\n3. Ajusta la velocidad con el slider\n4. Presiona INICIAR TAP TAP\n5. TikTok se abre automáticamente\n6. Ve a un Live — los corazones\n   se enviarán solos\n7. Toca el botón rojo flotante\n   para detener en cualquier momento"
            android:textSize="13sp"
            android:textColor="#aaaaaa"
            android:lineSpacingMultiplier="1.6"
            android:background="#2a2a3e"
            android:padding="16dp" />

    </LinearLayout>
</ScrollView>
